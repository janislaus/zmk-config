#include "german-keymap.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT   0
#define NUMMY     1
#define SIGNS     2
#define EXTRA     3
#define NAV       4
#define BLUE      5
#define GAME      6
#define POLISH    7
#define LINUX_MODE 8
#define MAC_MODE   9
#define LINUX_EXTRA 10
#define LINUX_NAV   11
#define MAC_EXTRA   12
#define MAC_NAV     13

// Deliberately aggressive: short enough that accidental sticky modifiers do
// not linger, but long enough to roll/chain Ctrl -> Shift -> Alt/GUI -> key.
#define STICKY_TIMEOUT_MS 500

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
};

&lt {
    tapping-term-ms = <160>;
};

/ {
    behaviors {
        sks: sticky_modifier {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Sticky modifier (500 ms)";
            bindings = <&kp>;
            release-after-ms = <STICKY_TIMEOUT_MS>;
            quick-release;
            ignore-modifiers;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-layer-toggle";
            #binding-cells = <1>;
            display-name = "Layer ON";
            toggle-mode = "on";
            locking;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-layer-toggle";
            #binding-cells = <1>;
            display-name = "Layer OFF";
            toggle-mode = "off";
            locking;
        };

        hm: function_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Function / Shift";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional hold-tap";
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <29>;
        };
    };

    macros {
        grave: grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Grave";
            wait-ms = <0>;
            bindings = <&macro_tap_time 0>, <&macro_tap &kp DE_GRV &kp DE_GRV>;
        };

        asw: asw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "App switch";
            wait-ms = <0>;
            bindings =
                <&macro_press &mo NUMMY &kp RGUI>,
                <&macro_pause_for_release>,
                <&macro_release &mo NUMMY &kp RGUI>;
        };

        circ: circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Circumflex";
            wait-ms = <0>;
            bindings = <&macro_tap_time 0>, <&macro_tap &kp DE_CIRC &kp DE_CIRC>;
        };

        // OS mode selectors. Windows is the baseline (both state layers off).
        os_windows: os_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "OS - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off LINUX_MODE>, <&tog_off MAC_MODE>;
        };

        os_linux: os_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "OS - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off MAC_MODE>, <&tog_on LINUX_MODE>;
        };

        os_mac: os_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "OS - macOS";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off LINUX_MODE>, <&tog_on MAC_MODE>;
        };

        // Bluetooth host selectors combine selected profile, BLE output and OS mode.
        // Default mapping: 0 Windows, 1 Linux, 2 macOS, 3 Windows, 4 Linux.
        // Edit these five macros if your paired-device order differs.
        bt0_windows: bt0_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 0 - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>, <&tog_off LINUX_MODE>, <&tog_off MAC_MODE>;
        };

        bt1_linux: bt1_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 1 - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 1>, <&out OUT_BLE>, <&tog_off MAC_MODE>, <&tog_on LINUX_MODE>;
        };

        bt2_mac: bt2_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 2 - macOS";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 2>, <&out OUT_BLE>, <&tog_off LINUX_MODE>, <&tog_on MAC_MODE>;
        };

        bt3_windows: bt3_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 3 - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 3>, <&out OUT_BLE>, <&tog_off LINUX_MODE>, <&tog_off MAC_MODE>;
        };

        bt4_linux: bt4_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 4 - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 4>, <&out OUT_BLE>, <&tog_off MAC_MODE>, <&tog_on LINUX_MODE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_rgui {
            timeout-ms = <80>;
            key-positions = <16 17 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&asw>;
        };

        combo_esc {
            timeout-ms = <80>;
            key-positions = <11 12 13 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp ESC>;
        };

        combo_del {
            timeout-ms = <80>;
            key-positions = <1 2 3>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp DEL>;
        };

        combo_bspc {
            timeout-ms = <80>;
            key-positions = <21 22 23>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp BSPC>;
        };

        fishy {
            timeout-ms = <80>;
            key-positions = <17 18 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp LA(M)>;
        };

        // User-requested thumb modifier combos:
        // outer thumbs (30 + 35) -> Alt / Option
        combo_alt {
            timeout-ms = <60>;
            key-positions = <30 35>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&sks LALT>;
        };

        // middle thumbs (31 + 34) -> Win / Command
        combo_gui {
            timeout-ms = <60>;
            key-positions = <31 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&sks LGUI>;
        };

        tmux {
            timeout-ms = <80>;
            key-positions = <11 12 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp LA(J)>;
        };

        game_on {
            timeout-ms = <80>;
            key-positions = <30 31 32>;
            layers = <DEFAULT LINUX_MODE MAC_MODE>;
            bindings = <&tog_on GAME>;
        };

        game_off {
            timeout-ms = <80>;
            key-positions = <30 31 32>;
            layers = <GAME>;
            bindings = <&tog_off GAME>;
        };

        polish_on {
            timeout-ms = <80>;
            key-positions = <33 34 35>;
            layers = <DEFAULT LINUX_MODE MAC_MODE>;
            bindings = <&tog_on POLISH>;
        };

        polish_off {
            timeout-ms = <80>;
            key-positions = <33 34 35>;
            layers = <POLISH>;
            bindings = <&tog_off POLISH>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        linux_extra {
            if-layers = <LINUX_MODE EXTRA>;
            then-layer = <LINUX_EXTRA>;
        };

        linux_nav {
            if-layers = <LINUX_MODE NAV>;
            then-layer = <LINUX_NAV>;
        };

        mac_extra {
            if-layers = <MAC_MODE EXTRA>;
            then-layer = <MAC_EXTRA>;
        };

        mac_nav {
            if-layers = <MAC_MODE NAV>;
            then-layer = <MAC_NAV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&pht DE_AT DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T             &kp DE_Z  &pht DE_UE DE_U  &kp DE_I  &pht DE_OE DE_O  &kp DE_P
&pht DE_AE DE_A  &pht DE_SS DE_S  &kp DE_D  &kp DE_F  &kp DE_G     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                    &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL          &sks LSHFT  &lt NUMMY ESC  &lt NAV TAB
            >;
        };

        nummy_layer {
            display-name = "Numbers";
            bindings = <
&kp DE_EXLM  &kp DE_DQUO  &kp N0  &mt DE_EURO DLLR  &kp DE_PERC    &mt DE_SECT DE_AMPR  &kp DE_SLSH  &kp DE_PLUS  &kp DE_ASTR  &kp DE_HASH
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5                               &kp N6  &kp N7  &kp N8  &kp N9  &kp BSPC
&kp DE_TILD  &kp DE_QUES  &kp DE_QUOT  &kp DE_EQL  &circ            &kp DE_PIPE  &kp DE_BSLS  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL          &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        signs_layer {
            display-name = "Symbols";
            bindings = <
&kp DE_EXLM  &kp DE_DQUO  &kp DE_DEG  &mt DE_EURO DLLR  &kp DE_PERC  &mt DE_SECT DE_AMPR  &kp DE_SLSH  &kp DE_PLUS  &kp DE_ASTR  &kp DE_HASH
&grave  &kp DE_LCBR  &kp DE_LBRC  &kp DE_LPRN  &kp DE_LABK           &kp DE_RABK  &kp DE_RPRN  &kp DE_RBRC  &kp DE_RCBR  &kp BSPC
&kp DE_TILD  &kp DE_QUES  &kp DE_QUOT  &kp DE_EQL  &circ             &kp DE_PIPE  &kp DE_BSLS  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&kp F5  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp PG_UP          &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&kp LC(DE_A)  &kp LC(DE_X)  &kp LC(INS)  &kp LS(INS)  &kp LC(DE_Z)    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp BSPC
&kp LS(INS)  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp PSCRN             &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
&sl BLUE  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp PG_UP          &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&kp LC(DE_A)  &kp LC(DE_X)  &kp LC(INS)  &kp LS(INS)  &kp LC(DE_Z)    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&kp LS(INS)  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp PSCRN             &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        blue_layer {
            display-name = "Hosts / Settings";
            bindings = <
&kp DE_EXLM  &kp C_VOL_DN  &kp LC(DE_Z)  &kp C_VOL_UP  &kp PG_UP     &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&bt0_windows  &bt1_linux  &bt2_mac  &bt3_windows  &bt4_linux                       &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&bt BT_CLR  &os_windows  &os_linux  &os_mac  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &studio_unlock  &kp F9  &kp F10
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        game_layer {
            display-name = "Game";
            bindings = <
&kp DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T                     &kp DE_Z  &kp DE_U  &kp DE_I  &kp DE_O  &kp DE_P
&kp DE_A  &kp DE_S  &kp DE_D  &kp DE_F  &kp DE_G                     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                     &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &kp ENTER  &kp SPACE  &kp ESC                       &kp LSHFT  &kp ESC  &kp TAB
            >;
        };

        polish_layer {
            display-name = "Polish";
            bindings = <
&pht DE_AT DE_Q  &kp DE_W  &pht PL_E DE_E  &kp DE_R  &kp DE_T       &kp DE_Z  &pht DE_UE DE_U  &kp DE_I  &pht DE_OE DE_O  &kp DE_P
&pht PL_A DE_A  &pht DE_SS DE_S  &kp DE_D  &kp DE_F  &kp DE_G       &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                    &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL          &sks LSHFT  &lt NUMMY ESC  &lt NAV TAB
            >;
        };

        // Linux state layer. Transparent; semantic shortcuts are provided by
        // conditional Linux overlays when EXTRA/NAV are active.
        linux_mode_layer {
            display-name = "Linux mode (state)";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        // macOS state layer. Transparent; semantic shortcuts are provided by
        // conditional macOS overlays when EXTRA/NAV are active.
        mac_mode_layer {
            display-name = "macOS mode (state)";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        // Linux semantic overlay. K_COPY/K_PASTE/K_CUT/K_UNDO are real HID
        // editing keys, avoiding terminal control sequences such as Ctrl+C.
        // Select All has no equivalent keyboard editing key in ZMK, so it
        // remains Ctrl+A.
        linux_extra_layer {
            display-name = "Linux Extra overlay";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&kp LC(DE_A) &kp K_CUT &kp K_COPY &kp K_PASTE &kp K_UNDO   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        linux_nav_layer {
            display-name = "Linux Nav overlay";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&kp LC(DE_A) &kp K_CUT &kp K_COPY &kp K_PASTE &kp K_UNDO   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        // macOS semantic overlay: Command+A/X/C/V/Z.
        mac_extra_layer {
            display-name = "macOS Extra overlay";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&kp LG(DE_A) &kp LG(DE_X) &kp LG(DE_C) &kp LG(DE_V) &kp LG(DE_Z)   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        mac_nav_layer {
            display-name = "macOS Nav overlay";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&kp LG(DE_A) &kp LG(DE_X) &kp LG(DE_C) &kp LG(DE_V) &kp LG(DE_Z)   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
