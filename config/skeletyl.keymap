#include "german-keymap.h"
#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/modifiers.h>

#define DEFAULT      0
#define NUMMY        1
#define SIGNS        2
#define EXTRA        3
#define NAV          4
#define BLUE         5
#define GAME         6
#define POLISH       7
#define LINUX_MODE   8
#define MAC_MODE     9
#define LINUX_EXTRA 10
#define LINUX_NAV   11
#define MAC_EXTRA   12
#define MAC_NAV     13

#define STICKY_TIMEOUT_MS 500

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
};

&lt {
    tapping-term-ms = <160>;
};


// Unicode input. OS selectors below keep this mode in sync with the host.
&uc {
    default-mode = <UC_MODE_LINUX>;
};

/ {
    behaviors {
        sks: sticky_modifier {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Sticky modifier (500 ms)";
            bindings = <&kp>;
            release-after-ms = <STICKY_TIMEOUT_MS>;
            quick-release;
            ignore-modifiers;
        };

        // Explicit key-toggle variants used by the visual app/tab switchers.
        // "on" is idempotent: repeated E/R taps keep the modifier held instead
        // of toggling it off. The EXTRA thumb releases all switcher modifiers.
        kt_on: key_toggle_on_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key toggle ON";
            toggle-mode = "on";
        };

        kt_off: key_toggle_off_only {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            display-name = "Key toggle OFF";
            toggle-mode = "off";
        };

        // Polish one-shot layer that survives modifier presses. Unlike ZMK's
        // standard &sl (quick-release), this stays active through Shift and
        // releases only after the actual non-modifier Polish key is released.
        pls: polish_sticky_layer {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Polish one-shot (modifier aware)";
            bindings = <&mo>;
            release-after-ms = <2000>;
            ignore-modifiers;
        };

        // Unicode needs Shift to remain active while &uc evaluates the key.
        // No quick-release here: tap Shift, then the Polish letter.
        pl_sks: polish_sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Polish sticky Shift";
            bindings = <&kp>;
            release-after-ms = <1500>;
            ignore-modifiers;
        };

        // Right Shift thumb: quick tap keeps the existing sticky-Shift UX;
        // holding it behaves like a normal physical Shift. This is essential
        // for repeatedly walking backwards through an open switcher.
        shft: shift_hold_sticky_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Shift hold / sticky tap";
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&sks>;
        };

        // Same dual Shift on the Polish layer, but the tap uses the
        // non-quick-release sticky Shift so Unicode reliably sees Shift.
        pl_shft: polish_shift_hold_sticky_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Polish Shift hold / sticky tap";
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&pl_sks>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Layer ON";
            toggle-mode = "on";
            locking;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Layer OFF";
            toggle-mode = "off";
            locking;
        };

        hm: function_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Function / Shift";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional hold-tap";
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <29>;
        };

        extra_lt: extra_layer_tap_with_cleanup {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "EXTRA / Enter + switcher cleanup";
            flavor = "tap-preferred";
            tapping-term-ms = <160>;
            bindings = <&extra_hold>, <&kp>;
        };

        // Semantic shortcuts with Shift-aware reverse/alternate actions.
        // Shift is consumed by mod-morph, so the morphed binding receives only
        // the modifiers explicitly encoded in that binding.
        win_close_reopen: win_close_reopen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Close / Reopen tab";
            bindings = <&kp LC(DE_W)>, <&kp LC(LS(DE_T))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_close_reopen: mac_close_reopen {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Close / Reopen tab (macOS)";
            bindings = <&kp LG(DE_W)>, <&kp LG(LS(DE_T))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_app_switch: win_app_switch {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "App switch (held Alt)";
            bindings = <&win_app_next>, <&win_app_prev>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_app_switch: linux_app_switch {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "App switch (held Super, Linux/GNOME)";
            bindings = <&linux_app_next>, <&linux_app_prev>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_app_switch: mac_app_switch {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "App switch (held Command, macOS)";
            bindings = <&mac_app_next>, <&mac_app_prev>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        tab_switch: tab_switch {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Tab switch (held Ctrl)";
            bindings = <&tab_next>, <&tab_prev>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        win_undo_redo: win_undo_redo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Undo / Redo (Windows)";
            bindings = <&kp LC(DE_Z)>, <&kp LC(DE_Y)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        linux_undo_redo: linux_undo_redo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Undo / Redo (Linux)";
            bindings = <&kp LC(DE_Z)>, <&kp LC(LS(DE_Z))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mac_undo_redo: mac_undo_redo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            display-name = "Undo / Redo (macOS)";
            bindings = <&kp LG(DE_Z)>, <&kp LG(LS(DE_Z))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {

        // EXTRA hold wrapper: enables EXTRA while held and guarantees that
        // any visual switcher modifier is released when the thumb comes up.
        extra_hold: extra_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "EXTRA hold + switcher cleanup";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &mo EXTRA>,
                <&macro_pause_for_release>,
                <&macro_tap &kt_off LALT &kt_off LGUI &kt_off LCTRL>,
                <&macro_release &mo EXTRA>;
        };

        // Window/application switchers. The modifier is deliberately left
        // held; releasing the EXTRA thumb performs the cleanup above.
        win_app_next: win_app_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Windows app next";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LCTRL>, <&kt_off LGUI>, <&kt_on LALT>, <&kp TAB>;
        };

        win_app_prev: win_app_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Windows app previous";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LCTRL>, <&kt_off LGUI>, <&kt_on LALT>, <&kp LS(TAB)>;
        };

        linux_app_next: linux_app_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Linux app next";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LCTRL>, <&kt_off LALT>, <&kt_on LGUI>, <&kp TAB>;
        };

        linux_app_prev: linux_app_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Linux app previous";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LCTRL>, <&kt_off LALT>, <&kt_on LGUI>, <&kp LS(TAB)>;
        };

        mac_app_next: mac_app_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "macOS app next";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LCTRL>, <&kt_off LALT>, <&kt_on LGUI>, <&kp TAB>;
        };

        mac_app_prev: mac_app_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "macOS app previous";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LCTRL>, <&kt_off LALT>, <&kt_on LGUI>, <&kp LS(TAB)>;
        };

        tab_next: tab_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Tab next";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LALT>, <&kt_off LGUI>, <&kt_on LCTRL>, <&kp TAB>;
        };

        tab_prev: tab_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Tab previous";
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kt_off LALT>, <&kt_off LGUI>, <&kt_on LCTRL>, <&kp LS(TAB)>;
        };

        grave: grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Grave";
            wait-ms = <0>;
            bindings = <&macro_tap_time 0>, <&macro_tap &kp DE_GRV &kp DE_GRV>;
        };

        asw: asw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "App switch";
            wait-ms = <0>;
            bindings =
                <&macro_press &mo NUMMY &kp RGUI>,
                <&macro_pause_for_release>,
                <&macro_release &mo NUMMY &kp RGUI>;
        };

        circ: circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Circumflex";
            wait-ms = <0>;
            bindings = <&macro_tap_time 0>, <&macro_tap &kp DE_CIRC &kp DE_CIRC>;
        };

        // Bluetooth host selectors. Each selector sets profile, output, shortcut OS state,
        // and the matching Unicode input method. Edit the profile/OS association to match your hosts.
        bt0_win: bt0_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 0 - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>, <&tog_off LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_WIN_COMPOSE>;
        };

        bt1_linux: bt1_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 1 - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 1>, <&out OUT_BLE>, <&tog_on LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        bt2_mac: bt2_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 2 - macOS";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 2>, <&out OUT_BLE>, <&tog_off LINUX_MODE>, <&tog_on MAC_MODE>, <&uc UC_SET_MACOS>;
        };

        bt3_win: bt3_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 3 - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 3>, <&out OUT_BLE>, <&tog_off LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_WIN_COMPOSE>;
        };

        bt4_linux: bt4_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 4 - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 4>, <&out OUT_BLE>, <&tog_on LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        os_win: os_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Windows mode";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_WIN_COMPOSE>;
        };

        os_linux: os_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Linux mode";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_on LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        usb_linux: usb_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "USB - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&out OUT_USB>, <&tog_on LINUX_MODE>, <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        os_mac: os_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "macOS mode";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off LINUX_MODE>, <&tog_on MAC_MODE>, <&uc UC_SET_MACOS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_rgui {
            timeout-ms = <80>;
            key-positions = <16 17 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&asw>;
        };

        combo_esc {
            timeout-ms = <80>;
            key-positions = <11 12 13 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp ESC>;
        };

        combo_del {
            timeout-ms = <80>;
            key-positions = <1 2 3>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp DEL>;
        };

        combo_bspc {
            timeout-ms = <80>;
            key-positions = <21 22 23>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp BSPC>;
        };

        fishy {
            timeout-ms = <80>;
            key-positions = <17 18 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp LA(M)>;
        };

        // Left-hand-only modifier combos.
        // Left outer + left middle thumbs (30 + 31) -> sticky Alt / Option.
        // This fully overlaps the 30+31+32 game combo; ZMK supports fully
        // overlapping combos, and both use the same timeout.
        combo_alt {
            timeout-ms = <80>;
            key-positions = <30 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&sks LALT>;
        };

        // Restore the original left-hand Windows/Super combo:
        // D + F + left-middle thumb (Space) -> sticky GUI / Win / Command.
        // Positions 12 and 13 are D/F on the base layer; 31 is Space/SIGNS.
        combo_lgui {
            timeout-ms = <80>;
            key-positions = <12 13 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&sks LGUI>;
        };

        // Left middle + left inner thumbs (31 + 32) -> sticky Shift.
        // This keeps Shift fully on the left thumb cluster, next to Ctrl/Alt.
        combo_shift {
            timeout-ms = <80>;
            key-positions = <31 32>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&sks LSHFT>;
        };

        tmux {
            timeout-ms = <80>;
            key-positions = <11 12 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&kp LA(J)>;
        };

        // Right middle + right outer thumbs (34 + 35) -> Polish for one key.
        // This avoids the old three-thumb gesture and keeps Polish off EXTRA.
        combo_polish {
            timeout-ms = <80>;
            key-positions = <34 35>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE LINUX_MODE MAC_MODE LINUX_EXTRA LINUX_NAV MAC_EXTRA MAC_NAV>;
            bindings = <&pls POLISH>;
        };

        game_on {
            timeout-ms = <80>;
            key-positions = <30 31 32>;
            layers = <DEFAULT LINUX_MODE MAC_MODE>;
            bindings = <&tog_on GAME>;
        };

        game_off {
            timeout-ms = <80>;
            key-positions = <30 31 32>;
            layers = <GAME>;
            bindings = <&tog_off GAME>;
        };

    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        linux_extra {
            if-layers = <LINUX_MODE EXTRA>;
            then-layer = <LINUX_EXTRA>;
        };

        linux_nav {
            if-layers = <LINUX_MODE NAV>;
            then-layer = <LINUX_NAV>;
        };

        mac_extra {
            if-layers = <MAC_MODE EXTRA>;
            then-layer = <MAC_EXTRA>;
        };

        mac_nav {
            if-layers = <MAC_MODE NAV>;
            then-layer = <MAC_NAV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&pht DE_AT DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T             &kp DE_Z  &pht DE_UE DE_U  &kp DE_I  &pht DE_OE DE_O  &kp DE_P
&pht DE_AE DE_A  &pht DE_SS DE_S  &kp DE_D  &kp DE_F  &kp DE_G     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                    &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL          &shft LSHFT LSHFT  &lt NUMMY ESC  &lt NAV TAB
            >;
        };

        nummy_layer {
            display-name = "Numbers";
            bindings = <
&kp DE_EXLM  &kp DE_DQUO  &kp N0  &mt DE_EURO DLLR  &kp DE_PERC    &mt DE_SECT DE_AMPR  &kp DE_SLSH  &kp DE_PLUS  &kp DE_ASTR  &kp DE_HASH
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5                               &kp N6  &kp N7  &kp N8  &kp N9  &kp BSPC
&kp DE_TILD  &kp DE_QUES  &kp DE_QUOT  &kp DE_EQL  &circ            &kp DE_PIPE  &kp DE_BSLS  &kp COMMA  &kp DOT  &kp DE_MINS
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL          &shft LSHFT LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        signs_layer {
            display-name = "Symbols";
            bindings = <
&kp DE_EXLM  &kp DE_DQUO  &kp DE_DEG  &mt DE_EURO DLLR  &kp DE_PERC  &mt DE_SECT DE_AMPR  &kp DE_SLSH  &kp DE_PLUS  &kp DE_ASTR  &kp DE_HASH
&grave  &kp DE_LCBR  &kp DE_LBRC  &kp DE_LPRN  &kp DE_LABK           &kp DE_RABK  &kp DE_RPRN  &kp DE_RBRC  &kp DE_RCBR  &kp BSPC
&kp DE_TILD  &kp DE_QUES  &kp DE_QUOT  &kp DE_EQL  &circ             &kp DE_PIPE  &kp DE_BSLS  &kp COMMA  &kp DOT  &kp DE_MINS
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL           &shft LSHFT LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        extra_layer {
            display-name = "Extra / Semantic";
            // Clean semantic command layer: no media controls, no Polish hold-taps,
            // and no duplicate HJKL navigation. Unused positions intentionally swallow input.
            // W = close tab; Shift+W = reopen closed tab
            // E = app switch; Shift+E = reverse app switch
            // R = next tab; Shift+R = previous tab
            // T = new tab; A = select all; S = save; F = find
            // G = undo; Shift+G = redo; C/X/V = copy/cut/paste
            // B = screenshot; L = lock; P = print; + / - positions = zoom.
            bindings = <
&none  &win_close_reopen  &win_app_switch  &tab_switch  &kp LC(DE_T)        &none  &none  &kp LC(DE_PLUS)  &none  &kp LC(DE_P)
&kp LC(DE_A)  &kp LC(DE_S)  &none  &kp LC(DE_F)  &win_undo_redo        &none  &none  &none  &kp LG(DE_L)  &kp BSPC
&none  &kp LC(DE_X)  &kp LC(DE_C)  &kp LC(DE_V)  &kp LG(LS(DE_S))      &none  &none  &none  &none  &kp LC(DE_MINS)
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL              &shft LSHFT LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
&sl BLUE  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp PG_UP          &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&kp LC(DE_A)  &kp LC(DE_X)  &kp LC(DE_C)  &kp LC(DE_V)  &kp LC(DE_Z)  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&kp LC(DE_V)  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp PSCRN             &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL           &shft LSHFT LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        blue_layer {
            display-name = "Hosts / Settings";
            // The USB key is intentionally USB+Linux, so returning to the Ubuntu cable
            // also restores Linux shortcuts and Linux Unicode mode in one action.
            bindings = <
&kp DE_EXLM  &kp C_VOL_DN  &kp LC(DE_Z)  &kp C_VOL_UP  &kp PG_UP     &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&bt0_win  &bt1_linux  &bt2_mac  &bt3_win  &bt4_linux                       &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&bt BT_CLR  &os_win  &os_linux  &os_mac  &usb_linux                &out OUT_BLE  &out OUT_TOG  &studio_unlock  &kp F9  &kp F10
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL           &shft LSHFT LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        game_layer {
            display-name = "Game";
            bindings = <
&kp DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T                     &kp DE_Z  &kp DE_U  &kp DE_I  &kp DE_O  &kp DE_P
&kp DE_A  &kp DE_S  &kp DE_D  &kp DE_F  &kp DE_G                     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                     &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &kp ENTER  &kp SPACE  &kp ESC                       &kp LSHFT  &kp ESC  &kp TAB
            >;
        };

        polish_layer {
            display-name = "Polish (one shot)";
            bindings = <
&kp DE_Q  &kp DE_W  &uc 0x0119 0x0118  &kp DE_R  &kp DE_T       &uc 0x017C 0x017B  &kp DE_U  &kp DE_I  &uc 0x00F3 0x00D3  &kp DE_P
&uc 0x0105 0x0104  &uc 0x015B 0x015A  &kp DE_D  &kp DE_F  &kp DE_G       &kp DE_H  &kp DE_J  &kp DE_K  &uc 0x0142 0x0141  &kp BSPC
&kp DE_Y  &uc 0x017A 0x0179  &uc 0x0107 0x0106  &kp DE_V  &kp DE_B       &uc 0x0144 0x0143  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &extra_lt 0 RET  &lt SIGNS SPACE  &sks LCTRL          &pl_shft LSHFT LSHFT  &lt NUMMY ESC  &lt NAV TAB
            >;
        };

        linux_mode_layer {
            display-name = "Linux mode (state)";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        mac_mode_layer {
            display-name = "macOS mode (state)";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        linux_extra_layer {
            display-name = "Linux Extra overlay";
            bindings = <
&trans &trans &linux_app_switch &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &linux_undo_redo  &trans &trans &trans &trans &trans
&trans &trans &trans &trans &kp PSCRN          &trans &trans &trans &trans &trans
             &trans &trans &trans              &trans &trans &trans
            >;
        };

        linux_nav_layer {
            display-name = "Linux Nav overlay";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        mac_extra_layer {
            display-name = "macOS Extra semantic overlay";
            bindings = <
&trans  &mac_close_reopen  &mac_app_switch  &trans  &kp LG(DE_T)   &trans &trans &kp LG(DE_PLUS) &trans &kp LG(DE_P)
&kp LG(DE_A)  &kp LG(DE_S)  &trans  &kp LG(DE_F)  &mac_undo_redo  &trans &trans &trans &kp LC(LG(DE_Q)) &trans
&trans  &kp LG(DE_X)  &kp LG(DE_C)  &kp LG(DE_V)  &kp LG(LS(N3))   &trans &trans &trans &trans &kp LG(DE_MINS)
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        mac_nav_layer {
            display-name = "macOS Nav overlay";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&kp LG(DE_A) &kp LG(DE_X) &kp LG(DE_C) &kp LG(DE_V) &kp LG(DE_Z)   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
