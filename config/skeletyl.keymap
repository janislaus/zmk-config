#include "german-keymap.h"
#include <behaviors.dtsi>
#include <behaviors/unicode.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT   0
#define NUMMY     1
#define SIGNS     2
#define EXTRA     3
#define NAV       4
#define BLUE      5
#define GAME      6
#define POLISH    7
#define MAC_MODE  8
#define MAC_EXTRA 9
#define MAC_NAV   10
#define MAC_BLUE  11

// Deliberately aggressive: short enough that accidental sticky modifiers do
// not linger, but long enough to roll/chain Ctrl -> Shift -> Alt/GUI -> key.
#define STICKY_TIMEOUT_MS 500

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
};

&lt {
    tapping-term-ms = <160>;
};


// Unicode input. OS selectors below keep this mode in sync with the host.
&uc {
    default-mode = <UC_MODE_LINUX>;
};

/ {
    behaviors {
        sks: sticky_modifier {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Sticky modifier (500 ms)";
            bindings = <&kp>;
            release-after-ms = <STICKY_TIMEOUT_MS>;
            quick-release;
            ignore-modifiers;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Layer ON";
            toggle-mode = "on";
            locking;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Layer OFF";
            toggle-mode = "off";
            locking;
        };

        hm: function_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Function / Shift";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Positional hold-tap";
            flavor = "hold-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <29>;
        };
    };

    macros {
        grave: grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Grave";
            wait-ms = <0>;
            bindings = <&macro_tap_time 0>, <&macro_tap &kp DE_GRV &kp DE_GRV>;
        };

        asw: asw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "App switch";
            wait-ms = <0>;
            bindings =
                <&macro_press &mo NUMMY &kp RGUI>,
                <&macro_pause_for_release>,
                <&macro_release &mo NUMMY &kp RGUI>;
        };

        circ: circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Circumflex";
            wait-ms = <0>;
            bindings = <&macro_tap_time 0>, <&macro_tap &kp DE_CIRC &kp DE_CIRC>;
        };

        // Bluetooth host selectors. Each selector sets profile, output, shortcut OS state,
        // and the matching Unicode input method. Edit the profile/OS association to match your hosts.
        bt0_win: bt0_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 0 - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 0>, <&out OUT_BLE>, <&tog_off MAC_MODE>, <&uc UC_SET_WIN_COMPOSE>;
        };

        bt1_linux: bt1_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 1 - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 1>, <&out OUT_BLE>, <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        bt2_mac: bt2_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 2 - macOS";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 2>, <&out OUT_BLE>, <&tog_on MAC_MODE>, <&uc UC_SET_MACOS>;
        };

        bt3_win: bt3_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 3 - Windows";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 3>, <&out OUT_BLE>, <&tog_off MAC_MODE>, <&uc UC_SET_WIN_COMPOSE>;
        };

        bt4_linux: bt4_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "BT 4 - Linux";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_SEL 4>, <&out OUT_BLE>, <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        os_win: os_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Windows mode";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off MAC_MODE>, <&uc UC_SET_WIN_COMPOSE>;
        };

        os_linux: os_linux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Linux mode";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_off MAC_MODE>, <&uc UC_SET_LINUX>;
        };

        os_mac: os_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "macOS mode";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog_on MAC_MODE>, <&uc UC_SET_MACOS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_rgui {
            timeout-ms = <80>;
            key-positions = <16 17 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&asw>;
        };

        combo_esc {
            timeout-ms = <80>;
            key-positions = <11 12 13 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&kp ESC>;
        };

        combo_del {
            timeout-ms = <80>;
            key-positions = <1 2 3>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&kp DEL>;
        };

        combo_bspc {
            timeout-ms = <80>;
            key-positions = <21 22 23>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&kp BSPC>;
        };

        fishy {
            timeout-ms = <80>;
            key-positions = <17 18 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&kp LA(M)>;
        };

        // User-requested thumb modifier combos:
        // outer thumbs (30 + 35) -> Alt / Option
        combo_alt {
            timeout-ms = <60>;
            key-positions = <30 35>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&sks LALT>;
        };

        // middle thumbs (31 + 34) -> Win / Command
        combo_gui {
            timeout-ms = <60>;
            key-positions = <31 34>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&sks LGUI>;
        };

        tmux {
            timeout-ms = <80>;
            key-positions = <11 12 31>;
            layers = <DEFAULT NUMMY SIGNS EXTRA NAV BLUE POLISH MAC_MODE MAC_EXTRA MAC_NAV MAC_BLUE>;
            bindings = <&kp LA(J)>;
        };

        game_on {
            timeout-ms = <80>;
            key-positions = <30 31 32>;
            layers = <DEFAULT MAC_MODE>;
            bindings = <&tog_on GAME>;
        };

        game_off {
            timeout-ms = <80>;
            key-positions = <30 31 32>;
            layers = <GAME>;
            bindings = <&tog_off GAME>;
        };

        // Three right thumb keys -> one-shot Polish character layer.
        polish_one_shot {
            timeout-ms = <80>;
            key-positions = <33 34 35>;
            layers = <DEFAULT MAC_MODE>;
            bindings = <&sl POLISH>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mac_extra {
            if-layers = <MAC_MODE EXTRA>;
            then-layer = <MAC_EXTRA>;
        };

        mac_nav {
            if-layers = <MAC_MODE NAV>;
            then-layer = <MAC_NAV>;
        };

        mac_blue {
            if-layers = <MAC_MODE BLUE>;
            then-layer = <MAC_BLUE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&pht DE_AT DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T             &kp DE_Z  &pht DE_UE DE_U  &kp DE_I  &pht DE_OE DE_O  &kp DE_P
&pht DE_AE DE_A  &pht DE_SS DE_S  &kp DE_D  &kp DE_F  &kp DE_G     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                    &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL          &sks LSHFT  &lt NUMMY ESC  &lt NAV TAB
            >;
        };

        nummy_layer {
            display-name = "Numbers";
            bindings = <
&kp DE_EXLM  &kp DE_DQUO  &kp N0  &mt DE_EURO DLLR  &kp DE_PERC    &mt DE_SECT DE_AMPR  &kp DE_SLSH  &kp DE_PLUS  &kp DE_ASTR  &kp DE_HASH
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5                               &kp N6  &kp N7  &kp N8  &kp N9  &kp BSPC
&kp DE_TILD  &kp DE_QUES  &kp DE_QUOT  &kp DE_EQL  &circ            &kp DE_PIPE  &kp DE_BSLS  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL          &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        signs_layer {
            display-name = "Symbols";
            bindings = <
&kp DE_EXLM  &kp DE_DQUO  &kp DE_DEG  &mt DE_EURO DLLR  &kp DE_PERC  &mt DE_SECT DE_AMPR  &kp DE_SLSH  &kp DE_PLUS  &kp DE_ASTR  &kp DE_HASH
&grave  &kp DE_LCBR  &kp DE_LBRC  &kp DE_LPRN  &kp DE_LABK           &kp DE_RABK  &kp DE_RPRN  &kp DE_RBRC  &kp DE_RCBR  &kp BSPC
&kp DE_TILD  &kp DE_QUES  &kp DE_QUOT  &kp DE_EQL  &circ             &kp DE_PIPE  &kp DE_BSLS  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        extra_layer {
            display-name = "Extra";
            bindings = <
&kp F5  &kp C_VOL_DN  &kp LC(DE_Z)  &kp C_VOL_UP  &kp PG_UP          &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&kp LC(DE_C)  &kp LC(DE_V)  &kp LC(DE_X)  &kp LC(DE_A)  &kp PG_DN    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp BSPC
&kp LS(INS)  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp PSCRN             &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        nav_layer {
            display-name = "Navigation";
            bindings = <
&sl BLUE  &kp C_VOL_DN  &kp LC(DE_Z)  &kp C_VOL_UP  &kp PG_UP          &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&kp LC(DE_C)  &kp LC(DE_V)  &kp LC(DE_X)  &kp LC(DE_A)  &kp PG_DN    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&kp LS(INS)  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp PSCRN             &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        blue_layer {
            display-name = "Hosts / Settings";
            bindings = <
&kp DE_EXLM  &kp C_VOL_DN  &kp LC(DE_Z)  &kp C_VOL_UP  &kp PG_UP     &mt F11 F1  &mt F12 F2  &hm LSHFT F3  &kp F4  &kp F5
&bt0_win  &bt1_linux  &bt2_mac  &bt3_win  &bt4_linux                       &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp DEL
&bt BT_CLR  &os_win  &os_linux  &os_mac  &out OUT_USB             &out OUT_BLE  &out OUT_TOG  &studio_unlock  &kp F9  &kp F10
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL           &sks LSHFT  &lt NUMMY SPACE  &lt NAV TAB
            >;
        };

        game_layer {
            display-name = "Game";
            bindings = <
&kp DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T                     &kp DE_Z  &kp DE_U  &kp DE_I  &kp DE_O  &kp DE_P
&kp DE_A  &kp DE_S  &kp DE_D  &kp DE_F  &kp DE_G                     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp BSPC
&kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                     &kp DE_N  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &kp ENTER  &kp SPACE  &kp ESC                       &kp LSHFT  &kp ESC  &kp TAB
            >;
        };

        polish_layer {
            display-name = "Polish (one shot)";
            bindings = <
&kp DE_Q  &kp DE_W  &uc 0x0119 0x0118  &kp DE_R  &kp DE_T       &uc 0x017C 0x017B  &kp DE_U  &kp DE_I  &uc 0x00F3 0x00D3  &kp DE_P
&uc 0x0105 0x0104  &uc 0x015B 0x015A  &kp DE_D  &kp DE_F  &kp DE_G       &kp DE_H  &kp DE_J  &kp DE_K  &uc 0x0142 0x0141  &kp BSPC
&kp DE_Y  &uc 0x017A 0x0179  &uc 0x0107 0x0106  &kp DE_V  &kp DE_B       &uc 0x0144 0x0143  &kp DE_M  &kp COMMA  &kp DOT  &kp DE_MINS
                 &lt EXTRA RET  &lt SIGNS SPACE  &sks LCTRL          &sks LSHFT  &lt NUMMY ESC  &lt NAV TAB
            >;
        };

        // State-only layer.  Keep transparent; use the two OS buttons on BLUE.
        mac_mode_layer {
            display-name = "macOS mode (state)";
            bindings = <
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        // macOS semantic overlay for EXTRA: Undo + Copy/Paste/Cut/Select All.
        mac_extra_layer {
            display-name = "macOS Extra overlay";
            bindings = <
&trans &trans &kp LG(DE_Z) &trans &trans   &trans &trans &trans &trans &trans
&kp LG(DE_C) &kp LG(DE_V) &kp LG(DE_X) &kp LG(DE_A) &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        // macOS semantic overlay for NAV: Undo + Copy/Paste/Cut/Select All.
        mac_nav_layer {
            display-name = "macOS Nav overlay";
            bindings = <
&trans &trans &kp LG(DE_Z) &trans &trans   &trans &trans &trans &trans &trans
&kp LG(DE_C) &kp LG(DE_V) &kp LG(DE_X) &kp LG(DE_A) &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };

        // BLUE only needs the OS-specific Undo override.
        mac_blue_layer {
            display-name = "macOS Settings overlay";
            bindings = <
&trans &trans &kp LG(DE_Z) &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans
             &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
